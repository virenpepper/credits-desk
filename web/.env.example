# Copy to .env.local and fill in. Never commit .env.local.
# Upstash Redis (Vercel Marketplace adds these when you connect a Redis store; `vercel env pull` brings them down)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Claude API key (console.anthropic.com), used server-side only
ANTHROPIC_API_KEY=
# Any long random string: `openssl rand -hex 32`. The inbox agent sends it as x-ingest-token; it also gates POST /api/reset
INGEST_TOKEN=
